{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/logic-fallacy-auditor/report.schema.json",
  "title": "Logic Fallacy Auditor Report",
  "type": "object",
  "required": ["analysis_version", "summary", "findings", "fallacy_fallacy_caveat"],
  "properties": {
    "analysis_version": {"type": "string"},
    "summary": {
      "type": "object",
      "required": ["overall", "most_important"],
      "properties": {
        "overall": {"type": "string"},
        "most_important": {"type": "string"}
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fallacy_id", "name_zh", "name_en", "evidence_quote",
          "conclusion_or_target", "argumentative_move", "why_fallacious",
          "strongest_non_fallacious_interpretation", "adjudication",
          "confidence", "centrality", "fact_check_needed", "repair"
        ],
        "properties": {
          "fallacy_id": {"type": "string"},
          "name_zh": {"type": "string"},
          "name_en": {"type": "string"},
          "evidence_quote": {"type": "string", "minLength": 1},
          "conclusion_or_target": {"type": "string"},
          "argumentative_move": {"type": "string"},
          "why_fallacious": {"type": "string"},
          "strongest_non_fallacious_interpretation": {"type": "string"},
          "adjudication": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "centrality": {"enum": ["central", "supporting", "rhetorical"]},
          "fact_check_needed": {"type": "boolean"},
          "related_fallacies": {"type": "array", "items": {"type": "string"}},
          "repair": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "important_non_findings": {"type": "array", "items": {"type": "string"}},
    "fact_checks_needed": {"type": "array", "items": {"type": "string"}},
    "fallacy_fallacy_caveat": {"type": "string"}
  },
  "additionalProperties": true
}
